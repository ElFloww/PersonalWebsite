# Configuration EmailJS pour le formulaire de contact
# Documentation: https://www.emailjs.com/docs/

# 1. Créez un compte gratuit sur https://www.emailjs.com/
# 2. Ajoutez un service email (Gmail, Outlook, etc.)
# 3. Créez un template d'email
# 4. Copiez vos identifiants ici

# Service ID (depuis https://dashboard.emailjs.com/admin)
VITE_EMAILJS_SERVICE_ID=your_service_id

# Template ID (depuis https://dashboard.emailjs.com/admin/templates)
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# Public Key (depuis https://dashboard.emailjs.com/admin/account)
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Mot de passe pour la page admin (Visites)
VITE_ADMIN_PASSWORD=your-secret-password

# Variables disponibles dans votre template EmailJS:
# - {{from_name}} : Nom de l'expéditeur
# - {{from_email}} : Email de l'expéditeur
# - {{subject}} : Sujet du message
# - {{message}} : Contenu du message
# - {{to_name}} : Votre nom (Florent Dubut)
